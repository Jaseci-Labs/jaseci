digraph TensorGraph {
rankdir=LR;
"x" [label="x\nInput\n[2, 2]"];
"w" [label="w\nParameter\n[2, 2]"];
"h" [label="h\nMatMul\n[2, 2]"];
"r" [label="r\nReLU\n[2, 2]"];
"y" [label="y\nAdd\n[2, 2]"];
"x" -> "h" [label="a"];
"w" -> "h" [label="b"];
"h" -> "r" [label="x"];
"h" -> "y" [label="b"];
"r" -> "y" [label="a"];
}
